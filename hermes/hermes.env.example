# ──────────────────────────────────────────────────────────────
#  Hermes Agent — secrets / env  (copie para hermes.env e preencha)
#  NÃO comitar hermes.env com as keys reais. Este arquivo vai SEM newline?
#  Garanta uma linha em branco no final pra append por `>>` não grudar.
# ──────────────────────────────────────────────────────────────

# ─── LLM PRINCIPAL: Kimi Coding Plan ───
# Key sk-kimi-... auto-roteia pra api.kimi.com/coding/v1 (provider: kimi-coding).
# O modelo/provider são fixados no config.yaml, não aqui (ver README → Gotchas).
KIMI_API_KEY=sk-kimi-REPLACE_ME

# ─── FALLBACK: OpenRouter (gemini-flash) ───
# Usado quando o Kimi falha (rate-limit/5xx/conn). Configurado em
# config.yaml → fallback_providers. A key fica aqui:
OPENROUTER_API_KEY=sk-or-REPLACE_ME

# ─── SANDBOX: LOCAL (não sobe containers Docker extras → protege RAM) ───
TERMINAL_ENV=local
TERMINAL_TIMEOUT=60

# ─── ACESSO: travado ───
GATEWAY_ALLOW_ALL_USERS=false

# ─── CANAL TELEGRAM ───
# Token do @BotFather; ALLOWED_USERS/HOME_CHANNEL = seu user id numérico (@userinfobot).
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_ALLOWED_USERS=REPLACE_ME
TELEGRAM_HOME_CHANNEL=REPLACE_ME

# ─── XCRAPER (orquestração da prospecção) ───
# O Hermes dispara scrapes direto no service API do xcraper (POST /scrape + poll).
# O resultado é auto-pushed pro Xphere, onde o Website Analyzer roda sozinho.
XCRAPER_SERVICE_URL=https://xcraper.skale.club/api/service
XCRAPER_SERVICE_KEY=xsk_REPLACE_ME

# ─── XMAIL OUTREACH MCP ───
# Credencial escopada criada em /api/outreach/agent-credentials. Nunca reutilize
# XMAIL_SERVICE_KEY: ela e ampla e pertence ao adaptador legado do Xphere.
XMAIL_AGENT_API_URL=https://mail.skale.club/api/agent/outreach
XMAIL_AGENT_KEY=xma_REPLACE_ME

# ─── BROWSER AUTOMATION: deixe DESLIGADA (não setar keys de browser → poupa RAM) ───
# (BROWSERBASE_API_KEY / FIRECRAWL_API_KEY / CAMOFOX_URL — deixe ausentes)
