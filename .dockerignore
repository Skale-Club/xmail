node_modules
.git
# Keep every real env file out of the image (Dockerfile does `COPY . .`, and runtime env is
# injected via `-e`, so no .env should ever be baked into a layer). The example is safe to ship.
.env
.env.*
!.env.example
dist
api
*.log
README.md

# Not read by the running server (see the runtime-stage comment in the Dockerfile) and not
# needed to build it either — excluding them just keeps the build context (and layer cache
# invalidation) smaller.
hermes/
docs/
.planning/
.github/
tests/
**/*.test.ts
**/__tests__/
coverage/
.claude/
