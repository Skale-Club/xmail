# Supabase Configuration (server-side)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase Configuration (client-side - Vite requires VITE_ prefix)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Application branding (initial page title before React loads; DB branding overrides at runtime)
VITE_APP_NAME=Xmail

# Server-side branding fallback (used if DB has no branding record)
APP_COMPANY_NAME=Skale Club
APP_APPLICATION_NAME=Xmail

# Database - Supabase Pooler Connection (for Drizzle ORM)
# Use the pooler connection string from Supabase Dashboard > Settings > Database > Connection string > Mode: Session
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Server Configuration
PORT=9001
NODE_ENV=development

# JWT Secret for SMTP/IMAP auth and token signing
JWT_SECRET=your_jwt_secret_key

# Encryption keys (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your_encryption_key
OUTLOOK_TOKEN_ENCRYPTION_KEY=your_outlook_encryption_key

# Email Configuration (for sending emails)
#
# SMTP_HOST + SMTP_USER definem um RELAY de saída. Com os dois VAZIOS (o que producao usa desde
# 2026-08-16) a plataforma resolve o MX de cada destinatario e ENTREGA DIRETO, assinando com a
# chave DKIM do dominio remetente — e so assim SPF, DKIM e DMARC alinham com o SEU dominio. Por
# relay de terceiro que reescreve o corpo, a sua assinatura chega como
# `dkim=neutral (body hash did not verify)` e o alinhamento vira do dominio dele.
#
# A entrega direta precisa dos DOIS pre-requisitos abaixo. Sem eles, todo o envio falha:
#   1. porta 25 de SAIDA liberada no provedor (a Hetzner bloqueia por padrao; libere em
#      console.hetzner.com -> Limits -> Request change -> Unblock ports). Teste:
#        docker exec xmail node -e "require('net').createConnection({host:'gmail-smtp-in.l.google.com',port:25}).on('data',d=>console.log('ok',d.toString()))"
#   2. rDNS (PTR) do IP publico apontando para MAIL_HOST. Teste: `dig +short -x <IP>` deve
#      devolver mx.skale.club, e nao o PTR generico do provedor.
#
# NATIVE_DKIM_SIGN controla a assinatura propria QUANDO ha relay: 'auto' (padrao) nao assina em
# relays que reescrevem o corpo; 'always' forca assinar; 'never' nunca assina via relay.
# Sem relay a assinatura e sempre feita. Ver src/server/lib/relay-dkim-policy.ts.
SMTP_PORT=587
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com
# SMTP_HOST=            # deixe vazio para entrega direta
# SMTP_USER=            # deixe vazio para entrega direta
# NATIVE_DKIM_SIGN=auto

# Frontend URL
FRONTEND_URL=http://localhost:9000

# ─── Native Mail Server ────────────────────────────────────────────────────────
# The hostname Thunderbird / mail clients connect to. In production this should
# match the certificate used by the Node SMTP/IMAP/MX servers.
MAIL_HOST=localhost

# The email domain accepted by the platform. In production for SkaleClub this is
# skale.club, while MAIL_HOST is mx.skale.club.
MAIL_DOMAIN=yourdomain.com

# SMTP Submission port (587 prod = STARTTLS, 465 prod = implicit TLS, 2587 dev)
SMTP_SUBMISSION_PORT=2587

# IMAP port (993 prod = implicit TLS, 2993 dev)
IMAP_PORT=2993

# Inbound MX port. Defaults to 25 in production and 2525 in development when
# unset. Production needs port 25 published directly from Docker.
MX_PORT=2525

# TLS certificates — required for production use
# When set: IMAP uses implicit TLS, SMTP/MX offer STARTTLS (implicit TLS on 465)
# When unset: servers run in plaintext (dev mode). Mail clients will refuse or warn.
# On Hetzner: install certbot on host, mount /etc/letsencrypt into container via
# docker run -v /etc/letsencrypt:/etc/letsencrypt:ro (deploy workflow does this).
# MAIL_TLS_CERT_PATH=/etc/letsencrypt/live/mx.skale.club/fullchain.pem
# MAIL_TLS_KEY_PATH=/etc/letsencrypt/live/mx.skale.club/privkey.pem

# Toggle for embedded SMTP submission, IMAP, and MX servers. Default: enabled.
# Set to false for CI or dev sessions where you do not want mail ports bound.
# ENABLE_MAIL_SERVER=true

# In production, HTTP is routed by Coolify/Traefik to port 9001. Mail ports
# 25/587/993 bypass Traefik and must be published directly by Docker.

# ─── Xphere Orchestrator Integration (optional) ────────────────────────────────
# Machine-to-machine auth for /api/outreach/* — lets the Xphere orchestrator call
# outreach routes with an x-service-key header instead of a Supabase session.
# Unset = the bypass does not exist at all (fails closed).
# XMAIL_SERVICE_KEY=your_shared_service_key
# XMAIL_SERVICE_USER_ID + XMAIL_SERVICE_ORGANIZATION_ID bind that key to a single
# server-chosen principal and organization. The caller cannot pick its own identity or
# tenant. All three must be set together or the service path stays disabled (a key alone
# never authenticates).
# XMAIL_SERVICE_USER_ID=uuid_of_the_service_user
# XMAIL_SERVICE_ORGANIZATION_ID=uuid_of_the_bound_organization

# Durable Xphere event consumer. Producers write the canonical event to the outbox first;
# when both values are set, the adapter POSTs eligible events with retry/backoff and an
# Idempotency-Key header.
# XPHERE_EVENTS_URL=https://xphere.example.com/api/integrations/xmail/events
# XPHERE_EVENTS_API_KEY=your_xphere_api_key
# Crash-window reconciliation lookback for canonical outreach events (default 6, max 720).
# OUTREACH_EVENT_RECONCILE_LOOKBACK_HOURS=6

# Cloudflare R2 object storage (S3-compatible). When all three access values are set,
# R2 replaces Supabase Storage for inbox attachments AND branding assets — buckets
# 'inbox-attachments' (private) and 'branding-assets' (public) must exist in R2.
# R2_PUBLIC_BASE_URL is the public custom domain (or r2.dev host) bound to the
# branding-assets bucket; without it, public asset URLs keep pointing at Supabase.
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_PUBLIC_BASE_URL=https://assets.example.com
# R2_ENDPOINT=  # optional override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# Apollo.io prospect discovery and bounded enrichment. Server-side only: never use VITE_*.
# Search is separated from credit-consuming enrichment in the agent API.
# APOLLO_API_KEY=your_apollo_master_api_key

# Hermes does NOT use an environment-wide Xmail secret. Create/revoke its hashed,
# organization-bound credential via /api/outreach/agent-credentials and put the one-time
# clear token only in hermes/hermes.env as XMAIL_AGENT_KEY.

# ─── Telegram ops alerting ────────────────────────────────────────────────────
# The bot token and chat id are NOT set here. They live in the admin panel
# (/admin/integrations -> system_integrations), which is the single place an
# operator edits them; the token is encrypted at rest with
# OUTLOOK_TOKEN_ENCRYPTION_KEY. See docs/TELEGRAM-ALERTS.md.
#
# MONITOR_API_TOKEN is the shared secret that lets the GitHub Actions uptime
# probe read those credentials back out of the panel via
# GET /api/admin/integrations/monitor-config. Without it that endpoint returns
# 503 and the external probe falls back to its cached copy (or to the
# TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID repository secrets, if set). Generate with
# `openssl rand -hex 32` and set the SAME value as a GitHub repository secret.
# MONITOR_API_TOKEN=

# Fallback only — used when there is no database to read the panel from (and by
# the external probe's cold start). Leave unset to make the panel authoritative.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Only for a group with Topics enabled; omitted from the API call when unset.
# TELEGRAM_THREAD_ID=

# Alert tuning. Defaults in parentheses.
# ERROR_SPIKE_THRESHOLD=15        # errors per 5min window before one alert fires (15; measured 2026-08-30, post-fix)
# ERROR_SPIKE_COOLDOWN_MS=1800000 # silence after a spike alert (30min)
# OPS_ALERT_REPEAT_MS=21600000    # how long a persistent condition stays quiet (6h)
# QUEUE_STALL_MINUTES=15          # unsent age that counts as a stalled queue (15)
# RSS_WARN_MB=1024                # process memory warning threshold (1024)
# DISK_WARN_PERCENT=85            # filesystem usage warning threshold (85)
